# Django Secret Key
SECRET_KEY=django-insecure-change-this-in-production-use-a-strong-secret-key

# Debug mode (False for production, True for local development)
DEBUG=False

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=food-rescue-connect.onrender.com,localhost,127.0.0.1

# Database URL (Render PostgreSQL connection string)
# e.g., postgresql://food_rescue_user:password@dpg-xxx-a:5432/food_rescue
DATABASE_URL=postgresql://user:password@host:5432/dbname

# PostgreSQL SSL connectivity (default True for remote Render DB, False for localhost)
DB_SSL_REQUIRE=True

# CORS allowed origins (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://food-rescue-connect-indol.vercel.app

# CSRF trusted origins (comma-separated, no trailing slash)
CSRF_TRUSTED_ORIGINS=https://food-rescue-connect-indol.vercel.app,https://food-rescue-connect.onrender.com
